# CKAN Environment Configuration
# Copy this file to .env and update values as needed

# Timezone
TZ=UTC

# CKAN Server Configuration
CKAN_PORT=5000
CKAN_PORT_HOST=5000
CKAN_SITE_URL=http://localhost:5000

# Database Configuration
POSTGRES_USER=ckan
POSTGRES_PASSWORD=ckan
POSTGRES_DB=ckan
CKAN_DB_USER=ckan
CKAN_DB_PASSWORD=ckan
CKAN_DB=ckan
DATASTORE_READONLY_USER=datastore_readonly
DATASTORE_READONLY_PASSWORD=datastore_readonly
DATASTORE_DB=datastore

# Redis Configuration
REDIS_VERSION=7-alpine
CKAN_REDIS_URL=redis://redis:6379/1

# Solr Configuration
SOLR_IMAGE_VERSION=2.10-solr9
CKAN_SOLR_URL=http://solr:8983/solr/ckan

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# CKAN Plugins
CKAN__PLUGINS=image_view text_view recline_view datastore envvars

# gRPC RPC Service Configuration
CKAN_RPC_ENABLED=true
CKAN_RPC_HOST=0.0.0.0
CKAN_RPC_PORT=50051
CKAN_RPC_MAX_WORKERS=10
CKAN_RPC_MAX_MESSAGE_LENGTH=104857600

# CKAN Secret Configuration
CKAN_SECRET=your-secret-key-here
BEAKER_SESSION_SECRET=your-beaker-secret-here

# Debug Mode (development only)
DEBUG=false
